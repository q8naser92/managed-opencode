{
  "compilerOptions": {
    "target": "ES2023", "module": "Preserve", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "types": ["bun"],
    "allowImportingTsExtensions": true, "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "script/**/*.ts"]
}
